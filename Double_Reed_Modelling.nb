Cell[CellGroupData[{

Cell["\<\
but what is EXACTLY the stability condition for a decrease in oscillation \
amplitude? 



Below are analysis using mass flow rate (instead of volumetric flow rate) \
\>", "Title",
 CellChangeTimes->{{3.959697709982667*^9, 3.959697717554544*^9}, {
  3.959707850231278*^9, 3.959707857157157*^9}, {3.959780193302676*^9, 
  3.959780206113769*^9}},ExpressionUUID->"fbad7802-039e-40bc-b6bd-\
0f87d5357cf1"],

Cell[TextData[{
 "For isoentropic process and ideal gas, we have p2 = p1(p2/p1), V2 = \
V1(p2/p1)(\[Minus]1/\[Gamma]), T2 = T1(p2/p1)^((\[Gamma] \[Minus] \
1)/\[Gamma]). Thus we can solve for the ratio ",
 Cell[BoxData[
  FormBox[
   FractionBox["n1", "n2"], TraditionalForm]],ExpressionUUID->
  "f826963c-3d59-4691-b67b-08659b68a932"],
 "to be "
}], "Text",
 CellChangeTimes->{{3.959688658191185*^9, 3.959688701933859*^9}, {
  3.959688762340839*^9, 
  3.9596887867850647`*^9}},ExpressionUUID->"ed217970-5da1-42cd-9780-\
a845ee1b06f3"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"P1", " ", "=", " ", "575"}], ";", 
   RowBox[{"P2", "=", "425"}], ";"}], " ", 
  RowBox[{"(*", 
   RowBox[{"Data", " ", "from", " ", 
    RowBox[{"Nate", "'"}], "s", " ", "paper"}], 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"P1$Pa", " ", "=", " ", 
    RowBox[{"P1", " ", "*", " ", "1000"}]}], ";", 
   RowBox[{"P2$Pa", " ", "=", " ", 
    RowBox[{"P2", " ", "*", " ", "1000"}]}], ";"}], " ", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"in", " ", "Pa"}], ",", " ", 
    RowBox[{"kg", "*", 
     SuperscriptBox["m", 
      RowBox[{"-", "1"}]], "*", 
     SuperscriptBox["s", 
      RowBox[{"-", "2"}]]}]}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"T1", " ", "=", " ", "300"}], ";"}], " ", 
  RowBox[{"(*", 
   RowBox[{"room", " ", "temperature"}], "*)"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"density$ratio", " ", "=", " ", 
    RowBox[{
     FractionBox[
      RowBox[{"P1", "*", "V1"}], 
      RowBox[{"R", "*", "T1"}]], "*", 
     SuperscriptBox[
      RowBox[{"(", 
       FractionBox[
        RowBox[{"P2", "*", "V1", "*", 
         SuperscriptBox[
          RowBox[{"(", 
           RowBox[{"P2", "/", "P1"}], ")"}], 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"-", "1"}], "/", "\[Gamma]"}], ")"}]]}], 
        RowBox[{"R", "*", "T1", "*", 
         SuperscriptBox[
          RowBox[{"(", 
           RowBox[{"P2", "/", "P1"}], ")"}], 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"1", "-", "\[Gamma]"}], ")"}], "/", "\[Gamma]"}]]}]], 
       ")"}], 
      RowBox[{"-", "1"}]]}]}], ";"}], 
  RowBox[{"(*", 
   FractionBox[
    RowBox[{
     RowBox[{"P1", "^", "2"}], 
     SuperscriptBox[
      RowBox[{"(", 
       FractionBox["P2", "P1"], ")"}], 
      RowBox[{"2", "/", "\[Gamma]"}]]}], 
    RowBox[{"P2", "^", "2"}]], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"T2", " ", "=", " ", 
    RowBox[{
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{"P2", "/", "P1"}], ")"}], 
      FractionBox[
       RowBox[{"\[Gamma]", "-", "1"}], "\[Gamma]"]], "*", "T1"}]}], ";"}], 
  " ", 
  RowBox[{"(*", 
   RowBox[{"the", " ", "cooled", " ", "temperature"}], 
   "*)"}]}], "\[IndentingNewLine]", 
