Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"vReedDotIn", "[", 
    RowBox[{
    "t_", ",", "Pave_", ",", "Pmag_", ",", "Pbdry_", ",", "vdotMax_", ",", 
     "\[CapitalDelta]PMax_", ",", " ", "deltaPfunc_"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"deltaP", "=", 
       RowBox[{"Pbdry", "-", 
        RowBox[{"deltaPfunc", "[", 
         RowBox[{"t", ",", "Pave", ",", "Pmag"}], "]"}]}]}], "}"}], ",", 
     RowBox[{"(*", 
      RowBox[{"\[CapitalDelta]P_reed", 
       RowBox[{"(", "t", ")"}]}], "*)"}], 
     RowBox[{"Piecewise", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{"-", "vdotMax"}], "  ", 
           RowBox[{"(", 
            RowBox[{"1", "-", 
             RowBox[{"deltaP", "/", "\[CapitalDelta]PMax"}]}], ")"}], " ", 
           SqrtBox[
            FractionBox["1", "\[CapitalDelta]PMax"]], " ", 
           SqrtBox[
            RowBox[{"Abs", "[", "deltaP", "]"}]]}], ",", 
          RowBox[{"deltaP", "<=", "0"}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"vdotMax", "*", 
           RowBox[{"(", 
            RowBox[{"1", "-", 
             RowBox[{"deltaP", "/", "\[CapitalDelta]PMax"}]}], ")"}], "*", 
           RowBox[{"Sqrt", "[", 
            RowBox[{"deltaP", "/", "\[CapitalDelta]PMax"}], "]"}]}], ",", 
          RowBox[{"0", "<", "deltaP", "<", "\[CapitalDelta]PMax"}]}], "}"}], 
        ",", 
        RowBox[{"{", 
         RowBox[{"0", ",", 
          RowBox[{"deltaP", ">=", "\[CapitalDelta]PMax"}]}], "}"}]}], "}"}], 
      "]"}]}], "]"}]}], " ", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
    "Extend", " ", "the", " ", "original", " ", "expression", " ", "to", " ", 
     "account", " ", "for", " ", "negative", " ", "flow", " ", 
     RowBox[{"(", 
      RowBox[{"\[CapitalDelta]P", "<", "0"}], ")"}], " ", "The", " ", 
     "equation", " ", "generalizes", " ", "well"}], ",", " ", 
    RowBox[{
    "after", " ", "we", " ", "make", " ", "sure", " ", "the", " ", "sign", 
     " ", "is", " ", "right", " ", "and", " ", "take", " ", "absolute", " ", 
     "value"}]}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"vReedDotOut", "[", 
    RowBox[{
    "t_", ",", "Pave_", ",", "Pmag_", ",", "Pbdry_", ",", "vdotMax_", ",", 
     "\[CapitalDelta]PMax_", ",", "deltaPfunc_"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"deltaP", "=", " ", 
       RowBox[{
        RowBox[{"deltaPfunc", "[", 
         RowBox[{"t", ",", "Pave", ",", "Pmag"}], "]"}], "-", "Pbdry"}]}], 
      "}"}], ",", 
     RowBox[{"(*", 
      RowBox[{"\[CapitalDelta]P_reed", 
       RowBox[{"(", "t", ")"}]}], "*)"}], 
     RowBox[{"Piecewise", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"vdotMax", "  ", 
           RowBox[{"(", 
            RowBox[{"1", "-", 
             RowBox[{"deltaP", "/", "\[CapitalDelta]PMax"}]}], ")"}], " ", 
           SqrtBox[
            FractionBox["1", "\[CapitalDelta]PMax"]], " ", 
           SqrtBox[
            RowBox[{"Abs", "[", "deltaP", "]"}]]}], ",", 
          RowBox[{"deltaP", "<=", "0"}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{"-", "vdotMax"}], "*", 
           RowBox[{"(", 
            RowBox[{"1", "-", 
             RowBox[{"deltaP", "/", "\[CapitalDelta]PMax"}]}], ")"}], "*", 
           RowBox[{"Sqrt", "[", 
            RowBox[{"deltaP", "/", "\[CapitalDelta]PMax"}], "]"}]}], ",", 
          RowBox[{"0", "<", "deltaP", "<", "\[CapitalDelta]PMax"}]}], "}"}], 
        ",", 
        RowBox[{"{", 
         RowBox[{"0", ",", 
          RowBox[{"deltaP", ">=", "\[CapitalDelta]PMax"}]}], "}"}]}], "}"}], 
      "]"}]}], "]"}]}], " ", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
    "This", " ", "is", " ", "negative", " ", "of", " ", "the", " ", 
     "formula"}], ",", " ", 
    RowBox[{"also", " ", "reorder", " ", "subtraction"}]}], 
   "*)"}]}], "\[IndentingNewLine]"}], "Input",
