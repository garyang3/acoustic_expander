Cell[BoxData[
 RowBox[{"\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"TotalMassFlowRate", "[", " ", 
     RowBox[{"Pave_", ",", "Pmag_", ",", "deltaPfunc_"}], "]"}], ":=", " ", 
    RowBox[{"NIntegrate", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"nin", "*", 
        RowBox[{"vReedDotIn", "[", 
         RowBox[{
         "t", ",", "Pave", ",", "Pmag", ",", "Pin", ",", "vdotMaxIn", ",", 
          "\[CapitalDelta]PMaxIn", ",", "deltaPfunc"}], "]"}]}], "+", 
       RowBox[{"nout", "*", 
        RowBox[{"vReedDotOut", "[", 
         RowBox[{
         "t", ",", "Pave", ",", "Pmag", ",", "Pout", ",", "vdotMaxOut", ",", 
          "\[CapitalDelta]PMaxOut", ",", "deltaPfunc"}], "]"}]}]}], ",", 
      RowBox[{"{", 
       RowBox[{"t", ",", "0", ",", "1"}], "}"}]}], "]"}]}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"Plot", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"TotalMassFlowRate", "[", 
        RowBox[{"Pave", ",", "60", ",", "deltaPReed$Sin"}], "]"}], ",", 
       RowBox[{"TotalMassFlowRate", "[", 
        RowBox[{"Pave", ",", "63", ",", "deltaPReed$Sin"}], "]"}], ",", 
       RowBox[{"TotalMassFlowRate", "[", 
        RowBox[{"Pave", ",", "66", ",", "deltaPReed$Sin"}], "]"}]}], "}"}], 
     ",", 
     RowBox[{"{", 
      RowBox[{"Pave", ",", "470", ",", "530"}], "}"}], ",", 
     RowBox[{"PlotLegends", "->", 
      RowBox[{"{", 
       RowBox[{
       "\"\<Pmag=60\>\"", ",", "\"\<Pmag=63\>\"", ",", "\"\<Pmag=66\>\""}], 
       "}"}]}], ",", 
     RowBox[{"Frame", "->", "True"}], ",", 
     RowBox[{"FrameLabel", "->", 
      RowBox[{"{", 
       RowBox[{"\"\<Pave\>\"", ",", "\"\<Average Mass Flow Rate\>\""}], 
       "}"}]}], ",", 
     RowBox[{
     "PlotLabel", "->", "\"\<Average Flow Rate vs Average Pressure\>\""}], 
     ",", 
     RowBox[{"BaseStyle", "->", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"FontFamily", "->", "\"\<Helvetica\>\""}], ",", 
        RowBox[{"FontSize", "->", "12"}]}], "}"}]}]}], "]"}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Making", " ", "the", " ", "valves", " ", "symmetric", " ", "in", " ", 
     "mass", " ", "flow", " ", "rate", " ", "is", " ", 
     RowBox[{"easy", ".", " ", "Just"}], " ", "make", " ", "sure", " ", "the",
      " ", "height", " ", "of", " ", "the", " ", "output", " ", "is", " ", 
     "multiple", " ", "but", " ", "the", " ", "correct", " ", "density", " ", 
     "factor"}], "*)"}], "\[IndentingNewLine]"}]}]], "Input",
