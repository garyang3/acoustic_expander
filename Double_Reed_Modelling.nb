Cell[CellGroupData[{

Cell["\<\
Below, I would like to compare \[CapitalDelta]P * Vdot (this is acoustic \
work) and mdot * Cp * T (enthalpy flow)\
\>", "Section",
 CellChangeTimes->{{3.966958513143826*^9, 3.9669585649456587`*^9}, {
  3.966959321858399*^9, 3.9669593290706787`*^9}, {3.966959367074011*^9, 
  3.966959378105139*^9}, {3.966959669632475*^9, 
  3.9669597045201607`*^9}},ExpressionUUID->"72e01576-27bd-42ae-a037-\
7d3a1243ae4f"],

Cell[BoxData[
 RowBox[{"\n", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"AcousticPower$In", "[", 
      RowBox[{
      "t_", ",", "Pave_", ",", "Pmag_", ",", "Pbdry_", ",", "vdotMax_", ",", 
       "\[CapitalDelta]PMax_", ",", " ", "deltaPfunc_"}], "]"}], ":=", 
     RowBox[{
      RowBox[{"vReedDotIn", "[", 
       RowBox[{
       "t", ",", "Pave", ",", "Pmag", ",", "Pbdry", ",", "vdotMax", ",", 
        "\[CapitalDelta]PMax", ",", " ", "deltaPfunc"}], "]"}], "*", 
      RowBox[{"Abs", "[", 
       RowBox[{"(", 
        RowBox[{"Pbdry", "-", 
         RowBox[{"deltaPfunc", "[", 
          RowBox[{"t", ",", "Pave", ",", "Pmag"}], "]"}]}], ")"}], "]"}], "*",
       "1000"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"AcousticPower$Out", "[", 
      RowBox[{
      "t_", ",", "Pave_", ",", "Pmag_", ",", "Pbdry_", ",", "vdotMax_", ",", 
       "\[CapitalDelta]PMax_", ",", "deltaPfunc_"}], "]"}], ":=", 
     RowBox[{
      RowBox[{"vReedDotOut", "[", 
       RowBox[{
       "t", ",", "Pave", ",", "Pmag", ",", "Pbdry", ",", "vdotMax", ",", 
        "\[CapitalDelta]PMax", ",", " ", "deltaPfunc"}], "]"}], "*", 
      RowBox[{"Abs", "[", 
       RowBox[{"(", 
        RowBox[{"Pbdry", "-", 
         RowBox[{"deltaPfunc", "[", 
          RowBox[{"t", ",", "Pave", ",", "Pmag"}], "]"}]}], ")"}], "]"}], "*",
       "1000"}]}], ";"}]}]}]], "Input",
 CellChangeTimes->{{3.966958513143826*^9, 3.9669585649456587`*^9}, {
  3.966959321858399*^9, 3.9669593290706787`*^9}, {3.966959367074011*^9, 
  3.966959373266934*^9}, {3.9669594577567053`*^9, 3.966959470086925*^9}},
 CellLabel->"In[26]:=",ExpressionUUID->"dd4f6028-4c4f-40e9-bdd7-4a36912417b5"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"EnthalpyFlow$In", "[", 
     RowBox[{
     "t_", ",", "Pave_", ",", "Pmag_", ",", "Pbdry_", ",", "vdotMax_", ",", 
      "\[CapitalDelta]PMax_", ",", " ", "deltaPfunc_"}], "]"}], ":=", 
    RowBox[{
     RowBox[{"vReedDotIn", "[", 
      RowBox[{
      "t", ",", "Pave", ",", "Pmag", ",", "Pbdry", ",", "vdotMax", ",", 
       "\[CapitalDelta]PMax", ",", " ", "deltaPfunc"}], "]"}], "*", 
     "\[Rho]$nitrogen1", "*", "cp", "*", "T1"}]}], ";"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
   "Assuming", " ", "gas", " ", "at", " ", "inlet", " ", "valve", " ", "is", 
    " ", "just", " ", "nitrogen", " ", "at", " ", "room", " ", 
    "temperature"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"EnthalpyFlow$Out", "[", 
     RowBox[{
     "t_", ",", "Pave_", ",", "Pmag_", ",", "Pbdry_", ",", "vdotMax_", ",", 
      "\[CapitalDelta]PMax_", ",", " ", "deltaPfunc_"}], "]"}], ":=", 
    RowBox[{
     RowBox[{"vReedDotOut", "[", 
      RowBox[{
      "t", ",", "Pave", ",", "Pmag", ",", "Pbdry", ",", "vdotMax", ",", 
       "\[CapitalDelta]PMax", ",", " ", "deltaPfunc"}], "]"}], "*", 
     RowBox[{"\[Rho]$nitrogen1", "/", 
      FractionBox[
       RowBox[{
        RowBox[{"P1", "^", "2"}], 
        SuperscriptBox[
         RowBox[{"(", 
          FractionBox[
           RowBox[{"deltaPfunc", "[", 
            RowBox[{"t", ",", "Pave", ",", "Pmag"}], "]"}], "P1"], ")"}], 
         RowBox[{"2", "/", "\[Gamma]"}]]}], 
       RowBox[{
        RowBox[{"deltaPfunc", "[", 
         RowBox[{"t", ",", "Pave", ",", "Pmag"}], "]"}], "^", "2"}]]}], "*", 
     "cp", "*", 
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{
        RowBox[{"deltaPfunc", "[", 
         RowBox[{"t", ",", "Pave", ",", "Pmag"}], "]"}], "/", "P1"}], ")"}], 
      FractionBox[
       RowBox[{"\[Gamma]", "-", "1"}], "\[Gamma]"]], "*", "T1"}]}], ";"}], 
  " ", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"!", 
     RowBox[{"!", 
      RowBox[{"!", 
       RowBox[{"!", 
        RowBox[{"calculate", " ", "temperature"}]}]}]}]}], ",", " ", 
    RowBox[{"density", " ", "as", " ", "a", " ", "function", " ", "of", " ", 
     RowBox[{
      RowBox[{"pressure", "!!"}], "!!"}]}]}], "*)"}]}]}], "Input",
 CellChangeTimes->{{3.966959708519072*^9, 3.966959738541437*^9}, {
  3.966959844890798*^9, 3.9669598728397503`*^9}, {3.967813062664328*^9, 
  3.967813078466776*^9}, {3.968259072640326*^9, 3.968259076486237*^9}, {
  3.968259292810217*^9, 3.9682593347082567`*^9}, {3.9682593697759542`*^9, 
