Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"AdjustedEnthalpyFlow", "[", " ", 
     RowBox[{"t_", ",", "Pave_", ",", "Pmag_", ",", "deltaPfunc_"}], "]"}], ":=", 
    RowBox[{
     RowBox[{
      RowBox[{"EnthalpyFlow$In", "[", 
       RowBox[{
       "t", ",", "Pave", ",", "Pmag", ",", "Pin", ",", "vdotMaxIn", ",", 
        "\[CapitalDelta]PMaxIn", ",", "deltaPfunc"}], "]"}], "*", 
      RowBox[{"Boole", "[", "]"}]}], "+", 
     RowBox[{"EnthalpyFlow$Out", "[", 
      RowBox[{
      "t", ",", "Pave", ",", "Pmag", ",", "Pout", ",", "vdotMaxOut", ",", 
       "\[CapitalDelta]PMaxOut", ",", "deltaPfunc"}], "]"}]}]}], "*)"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"TotalEnthalpyFlow", "[", " ", 
      RowBox[{"Pave_", ",", "Pmag_", ",", "deltaPfunc_"}], "]"}], ":=", " ", 
     RowBox[{"NIntegrate", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"EnthalpyFlow$In", "[", 
         RowBox[{
         "t", ",", "Pave", ",", "Pmag", ",", "Pin", ",", "vdotMaxIn", ",", 
          "\[CapitalDelta]PMaxIn", ",", "deltaPfunc"}], "]"}], "+", 
        RowBox[{"EnthalpyFlow$Out", "[", 
         RowBox[{
         "t", ",", "Pave", ",", "Pmag", ",", "Pout", ",", "vdotMaxOut", ",", 
          "\[CapitalDelta]PMaxOut", ",", "deltaPfunc"}], "]"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"t", ",", "0", ",", "1"}], "}"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"TotalAcousticPower", "[", " ", 
      RowBox[{"Pave_", ",", "Pmag_", ",", "deltaPfunc_"}], "]"}], ":=", " ", 
     RowBox[{"NIntegrate", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"AcousticPower$In", "[", 
         RowBox[{
         "t", ",", "Pave", ",", "Pmag", ",", "Pin", ",", "vdotMaxIn", ",", 
          "\[CapitalDelta]PMaxIn", ",", "deltaPfunc"}], "]"}], "+", 
        RowBox[{"AcousticPower$Out", "[", 
         RowBox[{
         "t", ",", "Pave", ",", "Pmag", ",", "Pout", ",", "vdotMaxOut", ",", 
          "\[CapitalDelta]PMaxOut", ",", "deltaPfunc"}], "]"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"t", ",", "0", ",", "1"}], "}"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"Plot", "[", 
    RowBox[{
