Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"vReedDot", "[", "t_", "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", "deltaP", "}"}], ",", 
     RowBox[{
      RowBox[{"deltaP", "=", 
       RowBox[{"deltaPReed", "[", "t", "]"}]}], ";", 
      RowBox[{"(*", 
       RowBox[{"\[CapitalDelta]P_reed", 
        RowBox[{"(", "t", ")"}]}], "*)"}], 
      RowBox[{"Piecewise", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{
            RowBox[{"-", "c1"}], " ", "vdotMax", " ", 
            SqrtBox[
             FractionBox["1", "\[CapitalDelta]PMax"]], " ", 
            SqrtBox[
             RowBox[{"Abs", "[", "deltaP", "]"}]]}], ",", 
           RowBox[{"deltaP", "<=", "0"}]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"c1", "*", "vdotMax", "*", 
            RowBox[{"(", 
             RowBox[{"1", "-", 
              RowBox[{"deltaP", "/", "\[CapitalDelta]PMax"}]}], ")"}], "*", 
            RowBox[{"Sqrt", "[", 
             RowBox[{"deltaP", "/", "\[CapitalDelta]PMax"}], "]"}]}], ",", 
           RowBox[{"0", "<", "deltaP", "<", "\[CapitalDelta]PMax"}]}], "}"}], 
         ",", 
         RowBox[{"{", 
          RowBox[{"0", ",", 
           RowBox[{"deltaP", ">=", "\[CapitalDelta]PMax"}]}], "}"}]}], "}"}], 
       "]"}]}]}], "]"}]}], " ", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
    "Add", " ", "a", " ", "linear", " ", "continuation", " ", "of", " ", 
     "the", " ", "positive", " ", "resistance"}], ",", " ", 
    RowBox[{"do", " ", 
     RowBox[{"Series", "[", 
      RowBox[{
       RowBox[{"c1", "*", "vdotMax", "*", 
        RowBox[{"(", 
         RowBox[{"1", "-", 
          RowBox[{"deltaP", "/", "\[CapitalDelta]PMax"}]}], ")"}], "*", 
        RowBox[{"Sqrt", "[", 
         RowBox[{"deltaP", "/", "\[CapitalDelta]PMax"}], "]"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"deltaP", ",", "0", ",", "3"}], "}"}]}], "]"}], " ", "and", 
     " ", "take", " ", "the", " ", "first", " ", "term"}], ",", " ", 
    RowBox[{"note", " ", "that", " ", "I", " ", "used", " ", "t"}]}], "*)"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]"}]], "Input",
